---
import { skills, skillCategories } from '../data/content';

const catLabel = Object.fromEntries(skillCategories.map((c) => [c.id, c.label]));
const countFor = (id: string) => (id === 'all' ? skills.length : skills.filter((s) => s.cat === id).length);
---
<section id="skills" class="container section stack" style="gap: 36px" data-filter-root>
  <div class="stack" style="gap: 16px; max-width: 680px">
    <div class="eyebrow">03 · describe('skills')</div>
    <h2 class="h2">Toolkit &amp; coverage</h2>
  </div>
  <div class="chips" role="group" aria-label="Filter skills">
    {skillCategories.map((c, i) => (
      <button type="button" class="chip" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        {c.label} <span class="count">{countFor(c.id)}</span>
      </button>
    ))}
  </div>
  <div class="skills-grid">
    {skills.map((s) => (
      <div class="card skill" data-cats={s.cat}>
        <div class="skill-head">
          <h3>{s.name}</h3>
          <span class="mono cat">{catLabel[s.cat]}</span>
        </div>
        <p>{s.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .skill { padding: 20px 22px; border-radius: 14px; display: flex; flex-direction: column; gap: 10px; }
  .skill-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .skill h3 { font-size: 16px; font-weight: 600; line-height: 1.35; color: var(--text-strong); }
  .cat { flex: none; font-size: 11px; color: var(--muted); padding: 3px 8px; border-radius: 6px; background: var(--surface-2); white-space: nowrap; margin-top: 1px; }
  .skill p { font-size: 14px; line-height: 1.55; color: var(--muted); }
</style>

<script>
  import '../scripts/filters';
</script>
