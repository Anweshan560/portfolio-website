---
import Icon from './Icon.astro';

const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#process', label: 'Process' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
];
---
<header class="site-header">
  <nav aria-label="Primary" class="container nav">
    <a href="#top" class="brand">
      <span class="brand-mark" aria-hidden="true"><Icon name="check" stroke={2.6} /></span>
      <span>ANWESHAN RAI</span>
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
      <a href="#contact" class="btn btn-primary hire">Hire me</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: rgba(7, 11, 20, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav {
    padding-top: 14px; padding-bottom: 14px;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
  }
  .brand {
    display: flex; align-items: center; gap: 10px; min-height: 44px;
    text-decoration: none; color: var(--text);
    font-family: var(--font-mono); font-weight: 600; font-size: 16px;
  }
  .brand:hover { color: var(--text); }
  .brand-mark {
    width: 30px; height: 30px; border-radius: 8px;
    background: var(--accent); color: var(--accent-ink);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .nav-links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 26px; font-size: 15px; }
  .nav-link { color: var(--muted); text-decoration: none; transition: color 0.15s; }
  .nav-link:hover { color: var(--text); }
  .hire { min-height: 44px; padding: 0 18px; border-radius: 10px; font-size: 15px; }
  @media (max-width: 820px) {
    .nav-link { display: none; }
  }
</style>
