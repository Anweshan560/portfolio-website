---
import { stats } from '../data/content';
---
<section aria-label="Highlights" class="stats-wrap">
  <div class="container stats">
    {stats.map((s) => (
      <div class="stat">
        <div class="value">{s.value}</div>
        <div class="label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .stats-wrap { border-bottom: 1px solid var(--line); background: var(--bg-2); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { padding: 36px 24px; display: flex; flex-direction: column; gap: 6px; border-left: 1px solid var(--line); }
  .stat:first-child { padding-left: 0; border-left: 0; }
  .value { font-family: var(--font-display); font-weight: 700; font-size: 44px; color: var(--text-strong); }
  .label { font-size: 14px; color: var(--muted); }
  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(odd) { padding-left: 0; border-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .stat { padding: 24px 16px; }
    .value { font-size: 34px; }
  }
</style>
